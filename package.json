{
  "name": "eliza-town",
  "version": "3.0.0",
  "description": "Multi-agent town that turns a typed task into a working result, visualized as a 3D town",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "PORT=3001 bun --watch src/server.ts",
    "dev:client": "cd client && bun run dev",
    "build": "tsc && cd client && npm run build",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/smoke.ts",
    "postinstall": "cd client && npm install",
    "lint:unused": "npx knip"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pg": "^8.12.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "@elizaos/core": "next",
    "@elizaos/plugin-agent-orchestrator": "next",
    "@elizaos/plugin-anthropic": "next",
    "@elizaos/plugin-code": "next",
    "@elizaos/plugin-goals": "next",
    "@elizaos/plugin-groq": "next",
    "@elizaos/plugin-inmemorydb": "next",
    "@elizaos/plugin-openai": "next",
    "@elizaos/plugin-shell": "next",
    "@elizaos/plugin-todo": "next",
    "@e2b/code-interpreter": "^1.0.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "concurrently": "^8.2.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
