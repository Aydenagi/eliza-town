# Database connection
DATABASE_URL=postgresql://user:password@localhost:5432/eliza_town

# Claude API (uses ANTHROPIC_API_KEY from environment by default)
# ANTHROPIC_API_KEY=sk-ant-...

# Server
PORT=3000
NODE_ENV=development

# OAuth Integrations (optional)
# Slack - Create app at https://api.slack.com/apps
# SLACK_CLIENT_ID=your-slack-client-id
# SLACK_CLIENT_SECRET=your-slack-client-secret

# Gmail - Create credentials at https://console.cloud.google.com/apis/credentials
# GMAIL_CLIENT_ID=your-gmail-client-id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your-gmail-client-secret

# Messaging Channels (optional - OpenClaw-style always-on agent connections)
# Discord - Create bot at https://discord.com/developers/applications
# DISCORD_BOT_TOKEN=your-discord-bot-token

# Telegram - Create bot via @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Generic Webhook (for custom integrations)
# WEBHOOK_SECRET=your-webhook-secret
