# Everything here is optional. `bun src/server.ts` with no .env at all runs a full
# in-memory town in simulation mode, no API key required.

# Engine
# direct (default) = the built-in task pipeline. eliza = boot the ElizaOS runtime instead.
ENGINE=direct
PORT=3000

# LLM providers (any one of these enables real output)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Force one provider even if multiple keys are set. One of: anthropic, openai, groq.
LLM_PROVIDER=

# Anthropic-only. One of: low, medium, high. Default medium.
LLM_EFFORT=medium

# Let the browser send its own key per task (X-LLM-Provider / X-LLM-Key / X-LLM-Model
# headers) for tasks even when the server has no key configured. Set false to disable.
ALLOW_BYOK=true

# Storage
# Without this, agents and tasks live in memory and reset on restart.
DATABASE_URL=

# Where generated task files are written, one folder per task.
OUTPUT_DIR=./output

# Task queue
MAX_CONCURRENT_TASKS=2
MAX_QUEUE=20
TASK_RATE_LIMIT=5
TASK_RATE_WINDOW_MS=600000

# Demo mode
# When true, the town starts a task from a template whenever the queue sits empty.
DEMO_MODE=false
DEMO_TASK_INTERVAL=180000

# ENGINE=eliza only
# Lets ElizaOS agents read/write files and run shell commands in a sandbox.
CODER_ENABLED=false
SHELL_ENABLED=false
# CODER_ALLOWED_DIRECTORY=/path/to/sandbox
# CODER_TIMEOUT=30000
# SUBAGENT_MAX_ITERATIONS=25
USE_E2B=false
# E2B_API_KEY=
