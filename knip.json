{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/server.ts", "scripts/*.ts"],
  "project": ["src/**/*.ts"],
  "ignore": ["client/**"],
  "ignoreDependencies": [
    "@elizaos/*"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["knip"],
  "include": ["files", "dependencies", "unlisted", "duplicates"]
}
